        local value = Instance.new("TextLabel", card)
        value.Size = UDim2.new(0, 38, 0, 20)
        value.Position = UDim2.new(1, -48, 0, y)
        value.BackgroundTransparency = 1
        value.Text = tostring(default)
        value.TextColor3 = Color3.fromRGB(210, 120, 170)
        value.Font = Enum.Font.SourceSans
        value.TextSize = 13
        value.TextXAlignment = Enum.TextXAlignment.Right

        local dragging = false

        local function update(input)
            local pos = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
            local val = math.floor(pos * 255 + 0.5)
            fill.Size = UDim2.new(pos, 0, 1, 0)
            value.Text = tostring(val)
            callback(val)
        end

        bg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                update(input)
            end
        end)

        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)

        UIS.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                update(input)
            end
        end)
    end

    local r = math.floor(cfg.silentAimFOVColor.R * 255 + 0.5)
    local g = math.floor(cfg.silentAimFOVColor.G * 255 + 0.5)
    local b = math.floor(cfg.silentAimFOVColor.B * 255 + 0.5)

    local rv, gv, bv = r, g, b

    local function updateColor()
        cfg.silentAimFOVColor = Color3.fromRGB(rv, gv, bv)
        preview.BackgroundColor3 = cfg.silentAimFOVColor
    end

    addRGBSlider("R", 40, r, function(v) rv = v; updateColor() end)
    addRGBSlider("G", 72, g, function(v) gv = v; updateColor() end)
    addRGBSlider("B", 104, b, function(v) bv = v; updateColor() end)
end

